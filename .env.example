# --- Script generation (https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Stock footage (optional, Mixkit free stock video is used by default without API key) ---
PIXABAY_API_KEY=

# --- YouTube Data API v3 (OAuth, generated once via scripts/authorize_youtube.py) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Channel config ---
CHANNEL_NICHE="timeless philosophical wisdom, Stoic principles, and profound reflections on life"
# Piper voice name (NOT the old edge-tts/Azure names — edge-tts is rejected
# with a 403 from datacenter IPs, so narration now runs locally via Piper).
# The Dockerfile bakes in en_US-ryan-medium. Other male voices on
# huggingface.co/rhasspy/piper-voices: joe, john, norman, mike, bryce.
# An unrecognised name falls back to the default with a warning.
TTS_VOICE=en_US-ryan-medium
TTS_RATE=-12%
# Piper has no pitch control, so this is applied afterwards with ffmpeg,
# interpreted relative to a ~100Hz male fundamental (-15Hz ≈ 15% down).
TTS_PITCH=-15Hz
SENTENCE_COUNT=6
GROQ_MODEL=qwen/qwen3.8-27b
# Keep GROQ_MAX_TOKENS <= 800 to stay under Groq's 1000 OTPM rate limit for qwen3.8-27b
GROQ_MAX_TOKENS=600

UPLOAD_PRIVACY_STATUS=public

# Background music (free, royalty-free Mixkit tracks picked per-video to match
# the script's own mood/topic). Volume is relative to the voice track.
ENABLE_MUSIC=true
MUSIC_VOLUME=0.15

# Safety switch: pipeline will render but NOT upload unless this is "true".
AUTO_UPLOAD=false
