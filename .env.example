# --- Script generation (https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Stock footage ---
# WITHOUT a key here, footage cannot be matched to the script at all: Mixkit
# renders its search client-side, so scraping it returns the same ~30 generic
# clips for every query. Pexels is free (pexels.com/api), instant, no payment,
# and supports portrait clips so Shorts aren't cropped from landscape footage.
# Pexels stopped issuing keys; left here in case that changes.
PEXELS_API_KEY=
# RECOMMENDED. Free key, no payment details: https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# --- AI-generated visuals (Pollinations, free) ---
# Generates an image FROM each sentence's keywords instead of searching stock
# for something similar, so relevance is near-perfect. The anonymous tier
# answers 402 to roughly three quarters of requests and watermarks the rest, so
# a token is effectively required. A free account (no payment) supplies one.
POLLINATIONS_TOKEN=
# Only "sana" is free; the default and "flux" return 402 Payment Required.
POLLINATIONS_MODEL=sana
# true = generate imagery instead of searching stock, even when a stock key exists.
PREFER_AI_FOOTAGE=false

# --- YouTube Data API v3 (OAuth, generated once via scripts/authorize_youtube.py) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# The live token lives in SQLite at $DATA_DIR/tokens.db so the app can replace
# it by itself. This variable still works as an override: CHANGE it and the app
# adopts the new value on the next run, even if the store holds a dead token.
# Leaving it alone is a no-op, so a token the app rotated to on its own is never
# clobbered by the stale value sitting here. Mint a new one with:
#     python scripts/login.py
YOUTUBE_REFRESH_TOKEN=

# --- Self-service re-authorization ---
# Google expires the refresh token every 7 days while the OAuth consent screen
# is in Testing mode. No code can prevent that, but with these two set the fix
# is one click: open <service-url>/auth/start?key=<AUTH_SETUP_TOKEN>, approve
# the Google prompt, and the new token is written to the store -- no local
# script, no Railway variable edit, no redeploy.
#
# REQUIRED for /auth/start to serve at all. Any long random string; generate one
# with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The endpoints are public URLs, so without this gate a stranger could complete
# the consent flow with their own Google account and repoint the uploader at
# their channel. Unset = both endpoints return 503.
AUTH_SETUP_TOKEN=
# Origin this service is reachable at, no trailing slash. On Railway this is
# detected from RAILWAY_PUBLIC_DOMAIN, so leave it blank there. Set it for a
# local tunnel, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=
# Add <PUBLIC_BASE_URL>/oauth/callback to the Authorized redirect URIs of the
# OAuth client in Google Cloud Console, or the callback is rejected.

# Where run state and the token store are written. On Railway this must be a
# mounted volume or both are lost on every restart.
DATA_DIR=data

# --- Channel config ---
CHANNEL_NICHE="timeless philosophical wisdom, Stoic principles, and profound reflections on life"
# Piper voice name (NOT the old edge-tts/Azure names — edge-tts is rejected
# with a 403 from datacenter IPs, so narration now runs locally via Piper).
# The Dockerfile bakes in en_US-ryan-medium. Other male voices on
# huggingface.co/rhasspy/piper-voices: joe, john, norman, mike, bryce.
# An unrecognised name falls back to the default with a warning.
TTS_VOICE=en_US-ryan-medium
TTS_RATE=-12%
# Piper has no pitch control, so this is applied afterwards with ffmpeg,
# interpreted relative to a ~100Hz male fundamental (-15Hz ≈ 15% down).
TTS_PITCH=-15Hz
# Pause after each sentence, in seconds. The main lever for a calmer read --
# each sentence is its own clip, so without this they butt straight together.
TTS_SENTENCE_SILENCE=0.4
SENTENCE_COUNT=6
GROQ_MODEL=qwen/qwen3.8-27b
# Keep GROQ_MAX_TOKENS <= 800 to stay under Groq's 1000 OTPM rate limit for qwen3.8-27b
GROQ_MAX_TOKENS=600

UPLOAD_PRIVACY_STATUS=public

# Background music (free, royalty-free Mixkit tracks picked per-video to match
# the script's own mood/topic). Volume is relative to the voice track.
ENABLE_MUSIC=true
MUSIC_VOLUME=0.15

# Safety switch: pipeline will render but NOT upload unless this is "true".
AUTO_UPLOAD=false
