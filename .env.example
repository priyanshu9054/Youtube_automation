# --- Script generation (https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Stock footage (instant free key: https://pixabay.com/api/docs/) ---
PIXABAY_API_KEY=

# --- YouTube Data API v3 (OAuth, generated once via scripts/authorize_youtube.py) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Channel config ---
CHANNEL_NICHE="bite-sized science facts that make people say 'wait, really?'"
TTS_VOICE=en-US-AriaNeural
SENTENCE_COUNT=8

# Keep this at "private" until you've manually reviewed several outputs.
UPLOAD_PRIVACY_STATUS=private

# Safety switch: pipeline will render but NOT upload unless this is "true".
AUTO_UPLOAD=false
